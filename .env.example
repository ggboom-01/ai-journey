# 环境变量模板
# 用法：复制本文件为 .env，然后填入你自己的密钥。
# .env 已被 .gitignore 忽略，不会提交到仓库。
#
#   Copy-Item .env.example .env

# ---- 大模型 API（按需填写，只填你在用的）----
# DeepSeek
DEEPSEEK_API_KEY=
# 阿里云百炼 / 通义千问
DASHSCOPE_API_KEY=
# 智谱 AI
ZHIPU_API_KEY=
# 月之暗面 Kimi
MOONSHOT_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=

# ---- 向量库 / 检索（用云端服务时填）----
MILVUS_URI=
MILVUS_TOKEN=

# ---- 可观测性（Langfuse / LangSmith）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_API_KEY=
